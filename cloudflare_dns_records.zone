;; ==============================================================================
;; CLOUDFLARE DNS ZONE CONFIGURATION
;; Domain: krisalahiranandanitownships.com
;; Compatibility: Cloudflare DNS Import / RFC 8499 Standard BIND Format
;; ==============================================================================

$ORIGIN krisalahiranandanitownships.com.
$TTL 300

;; 1. CLOUDFLARE PAGES ROUTING (Proxied / Orange Cloud)
;; Root CNAME flattened automatically by Cloudflare
@                       IN  CNAME   krisalahiranandani.pages.dev.
www                     IN  CNAME   krisalahiranandani.pages.dev.

;; 2. CERTIFICATE AUTHORITY AUTHORIZATION (CAA)
;; Strict lockdown: only Let's Encrypt, DigiCert, and Google Trust Services can issue SSL/TLS certificates
@                       IN  CAA     0 issue "letsencrypt.org"
@                       IN  CAA     0 issue "digicert.com"
@                       IN  CAA     0 issue "pki.goog"
@                       IN  CAA     0 issuewild "letsencrypt.org"
@                       IN  CAA     0 issuewild "digicert.com"
@                       IN  CAA     0 issuewild "pki.goog"
@                       IN  CAA     0 iodef "mailto:security@krisalahiranandanitownships.com"

;; 3. EMAIL REPUTATION, REPORTING & ANTI-SPOOFING LOCKDOWN
;; Strict SPF: Declares that NO outbound email is authorized directly from this domain (prevents phishing/spoofing)
@                       IN  TXT     "v=spf1 -all"

;; DMARC: Strict reject policy with aggregate forensic reporting to propsmartrealty@gmail.com
_dmarc                  IN  TXT     "v=DMARC1; p=reject; sp=reject; aspf=s; adkim=s; fo=1; rua=mailto:propsmartrealty@gmail.com; ruf=mailto:propsmartrealty@gmail.com"

;; DKIM Wildcard Null Policy: Rejects all unauthorized signed emails
*._domainkey            IN  TXT     "v=DKIM1; p="

;; Default Option A: RFC 7505 Null MX (Active when domain accepts NO incoming emails)
@                       IN  MX      0 .

;; ------------------------------------------------------------------------------
;; OPTION B: CLOUDFLARE EMAIL ROUTING (Free Lead Forwarding to Gmail)
;; If activating Cloudflare Email Routing to forward enquiry@ / info@ / sales@ 
;; to propsmartrealty@gmail.com, REMOVE the Null MX above and UNCOMMENT below:
;; ------------------------------------------------------------------------------
;; @                       IN  MX      1   route1.mx.cloudflare.net.
;; @                       IN  MX      5   route2.mx.cloudflare.net.
;; @                       IN  MX      9   route3.mx.cloudflare.net.
;; @                       IN  TXT     "v=spf1 include:_spf.mx.cloudflare.net ~all"
